+/**
+ * ¿Este equipo ya registrado es un Meitrack T399L? Basta una pista: marca, modelo o protocolo
+ * (T-213). Así la ficha no le da los comandos ni el puerto del Coban.
+ */
+export function esEquipoMeitrack(e: { fabricante?: string; modelo?: string; protocolo?: string } | null | undefined): boolean {
+  if (!e) return false;
+  const bajo = (v?: string) => (v ?? '').trim().toLowerCase();
+  return (
+    bajo(e.fabricante) === FABRICANTE_MEITRACK.toLowerCase() ||
+    bajo(e.modelo).includes(MODELO_MEITRACK.toLowerCase()) ||
+    bajo(e.protocolo) === PROTOCOLO_MEITRACK
+  );
+}
