@@ -0,0 +1,33 @@
+/**
+ * Spline Sans, la misma letra del panel web.
+ *
+ * Una fuente cargada con expo-font es UNA cara por peso: no se le puede pedir
+ * `fontWeight: '700'` a la regular (Android la engorda a mano y en web el
+ * navegador la "sintetiza"). Por eso el peso se traduce a la familia de su
+ * cara y el `fontWeight` se deja en normal.
+ */
+
+import {
+  SplineSans_400Regular,
+  SplineSans_500Medium,
+  SplineSans_600SemiBold,
+  SplineSans_700Bold,
+} from '@expo-google-fonts/spline-sans';
+import type { TextStyle } from 'react-native';
+
+/** Lo que se le pasa a `useFonts` en la raíz. */
+export const FUENTES_FOM = {
+  SplineSans_400Regular,
+  SplineSans_500Medium,
+  SplineSans_600SemiBold,
+  SplineSans_700Bold,
+};
+
+/** Familia de la cara que corresponde a un peso. */
+export function familiaPorPeso(peso: TextStyle['fontWeight']): string {
+  const n = typeof peso === 'number' ? peso : peso === 'bold' ? 700 : Number(peso) || 400;
+  if (n >= 700) return 'SplineSans_700Bold';
+  if (n >= 600) return 'SplineSans_600SemiBold';
+  if (n >= 500) return 'SplineSans_500Medium';
+  return 'SplineSans_400Regular';
+}
