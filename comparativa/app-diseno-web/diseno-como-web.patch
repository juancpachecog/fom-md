@@ -0,0 +1,42 @@
+import { StyleSheet, View } from 'react-native';
+
+import { ThemedText } from '@/components/themed-text';
+import { useTheme, type ColorTokens } from '@/theme';
+
+export type Kpi = {
+  /** Lo que cuenta, en minúscula de frase ("Abiertas", "En revisión"). */
+  label: string;
+  valor: number | string;
+  /** Color del número. Por defecto, el texto normal. */
+  tono?: keyof ColorTokens;
+};
+
+/**
+ * Fila de cifras arriba de una pantalla, como las del panel web: una tarjeta
+ * con hasta cuatro casillas hundidas, número grande y etiqueta chica debajo.
+ * Lo que se ve primero es cuánto hay de cada cosa.
+ */
+export function KpiFila({ items }: { items: Kpi[] }) {
+  const { colors, radii, spacing } = useTheme();
+  return (
+    <View style={[styles.tarjeta, { backgroundColor: colors.surface, borderRadius: radii.lg, gap: spacing.sm }]}>
+      {items.map((k) => (
+        <View key={k.label} style={[styles.casilla, { backgroundColor: colors.surfaceSunken }]}>
+          <ThemedText style={styles.valor} color={k.tono ?? 'text'} tabular numberOfLines={1}>
