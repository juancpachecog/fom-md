@@ -0,0 +1,269 @@
+import { useFocusEffect, usePathname, useRouter, type Href } from 'expo-router';
+import { useCallback, useState, type ReactNode } from 'react';
+import { StyleSheet, View } from 'react-native';
+import { useSafeAreaInsets } from 'react-native-safe-area-context';
+
+import { useAuth } from '@/auth';
+import { Appear } from '@/components/appear';
+import { BarraCarga } from '@/components/barra-carga';
+import { LogoEmpresa, hayLogoEmpresa } from '@/components/logo-empresa';
+import { PressableScale } from '@/components/pressable-scale';
+import { TabIcon } from '@/components/tab-icon';
+import { ThemedText } from '@/components/themed-text';
+import { getSinLeerPanel } from '@/services';
+import { useAdmin } from '@/session';
+import { useTheme } from '@/theme';
+
+/**
+ * EL ENCABEZADO DE LA APP, el mismo del panel web.
+ *
+ * Tres piezas flotantes con bordes redondos —la cápsula con la empresa y la
+ * sección, la campana en un círculo y tu avatar— y, debajo, el título grande
+ * de la pantalla con su bajada y su acción. Lo usan todas las pestañas de
+ * todos los roles, así que la app se ve igual en cualquier sitio.
+ *
+ * Sobre un mapa va `flotante`: las piezas se apoyan encima del mapa, un poco
+ * transparentes, y el título se omite (el mapa es el protagonista).
+ */
+
+/** El avatar del panel web: azul profundo con su aro. */
+const AVATAR_FONDO = '#194A74';
+const AVATAR_ARO = '#31608B';
+const AVATAR_TEXTO = '#EEF7FF';
+/** Superficie de las piezas cuando flotan sobre el mapa. */
+const SOBRE_MAPA = 'rgba(20, 26, 34, 0.94)';
+
+type Contexto = 'admin' | 'panel' | 'compania' | 'gerencial' | 'personal' | 'conductor';
+
+/** De qué superficie es la pantalla, por su ruta. */
+function contextoDe(ruta: string): Contexto {
+  const primero = ruta.split('/').filter(Boolean)[0] ?? '';
+  if (primero === 'admin' || primero === 'panel' || primero === 'compania' || primero === 'gerencial' || primero === 'personal') {
+    return primero;
+  }
+  return 'conductor';
+}
+
+/** A dónde lleva el avatar: la pestaña Perfil de cada rol. */
+const PERFIL: Partial<Record<Contexto, Href>> = {
+  admin: '/admin/mas',
+  panel: '/panel/mas',
+  compania: '/compania/mas',
+  conductor: '/mas',
+  // Sin pestaña Perfil: van directo a su ficha.
+  gerencial: '/mi-perfil',
+  personal: '/mi-perfil',
+};
+
+/** Iniciales (primera y última palabra), como en el panel web. */
+function iniciales(nombre: string): string {
+  const partes = nombre.trim().split(/\s+/).filter(Boolean);
+  if (partes.length === 0) return '';
+  const ultima = partes.length > 1 ? (partes[partes.length - 1][0] ?? '') : '';
+  return `${partes[0][0] ?? ''}${ultima}`.toUpperCase();
+}
+
+type EncabezadoFomProps = {
+  /** La línea chica en mayúsculas de la cápsula (la sección, o un saludo). */
+  seccion: string;
+  /** La línea grande de la cápsula. Por defecto, el nombre de la empresa. */
+  nombre?: string;
+  /** Título grande de la pantalla, debajo de las piezas. */
+  titulo?: string;
+  /** Una frase corta debajo del título. */
+  bajada?: string;
+  /** La acción principal de la pantalla, a la derecha del título. */
+  accion?: ReactNode;
+  /** La pantalla está refrescando lo que ya se ve: enciende la barra fina. */
+  cargando?: boolean;
+  /** Va encima de un mapa: piezas translúcidas y sin título. */
+  flotante?: boolean;
+  /**
+   * Cuántos avisos sin leer, cuando la pantalla ya los cuenta (el conductor).
+   * Sin este dato, el encabezado los cuenta solo con la empresa activa.
+   */
+  sinLeer?: number;
+};
+
+export function EncabezadoFom({
+  seccion,
+  nombre,
+  titulo,
+  bajada,
+  accion,
+  cargando,
+  flotante,
+  sinLeer,
+}: EncabezadoFomProps) {
+  const { colors, spacing, radii, brand } = useTheme();
+  const { user } = useAuth();
+  const { empresaId } = useAdmin();
+  const router = useRouter();
+  const ruta = usePathname();
+  const insets = useSafeAreaInsets();
+  const contexto = contextoDe(ruta);
+
+  // La empresa de la que se cuentan los avisos: la elegida en el panel o la
+  // propia. El admin FOM, fuera de una empresa, no tiene bandeja.
+  const companyId = contexto === 'admin' ? null : (empresaId ?? user?.companyId ?? null);
+  const [contados, setContados] = useState(0);
+  const cuentaPropia = sinLeer === undefined && contexto !== 'conductor' && !!companyId;
+
+  useFocusEffect(
+    useCallback(() => {
+      if (!cuentaPropia || !companyId) return;
+      let activo = true;
+      getSinLeerPanel(companyId)
+        .then((s) => {
+          if (activo) setContados(s.total);
+        })
+        // Sin poder contarlos, la campana se queda sin número.
+        .catch(() => undefined);
+      return () => {
+        activo = false;
+      };
+    }, [cuentaPropia, companyId]),
+  );
+
+  const avisos = sinLeer ?? (cuentaPropia ? contados : 0);
+  const conCampana = contexto === 'conductor' || !!companyId;
+  const irAvisos = () => {
+    if (contexto === 'conductor') router.navigate('/mis-notificaciones');
+    else if (companyId) router.navigate({ pathname: '/notificaciones', params: { companyId } });
+  };
+  const perfil = PERFIL[contexto];
+
+  const pieza = flotante ? SOBRE_MAPA : colors.surface;
+  // Con isotipo propio, la marca va sobre un cuadro neutro (sus colores son
+  // suyos); sin él, el cuadro de acento con las iniciales.
+  const conLogo = hayLogoEmpresa(brand.logoKey);
+
+  const fila = (
+    <View style={[styles.fila, { gap: spacing.sm }]}>
+      <View style={[styles.capsula, { backgroundColor: pieza }]}>
+        {conLogo ? (
+          <View style={[styles.marca, { backgroundColor: colors.surfaceSunken }]}>
+            <LogoEmpresa logoKey={brand.logoKey} size={26} />
+          </View>
+        ) : (
+          <View style={[styles.marca, { backgroundColor: colors.primary }]}>
+            <ThemedText style={[styles.marcaTexto, { color: colors.onPrimary }]}>{iniciales(brand.name)}</ThemedText>
+          </View>
+        )}
+        <View style={styles.flex1}>
+          <ThemedText style={[styles.eyebrow, { color: colors.textSecondary }]} numberOfLines={1}>
+            {seccion.toUpperCase()}
+          </ThemedText>
+          <ThemedText style={styles.nombre} numberOfLines={1}>
+            {nombre ?? brand.name}
+          </ThemedText>
+        </View>
+      </View>
+
+      {conCampana ? (
+        <PressableScale
+          onPress={irAvisos}
+          accessibilityRole="button"
+          accessibilityLabel={avisos > 0 ? `Alertas: ${avisos} sin leer` : 'Alertas'}
+          style={[styles.circulo, { backgroundColor: pieza, borderRadius: radii.pill }]}>
+          <TabIcon name="alertas" color={colors.text} size={20} />
+          {avisos > 0 ? (
+            <View style={[styles.insignia, { backgroundColor: colors.danger }]}>
+              <ThemedText style={[styles.insigniaTexto, { color: colors.onDanger }]} tabular>
+                {avisos > 99 ? '99+' : String(avisos)}
+              </ThemedText>
+            </View>
+          ) : null}
+        </PressableScale>
+      ) : null}
+
+      {user ? (
+        <PressableScale
+          onPress={perfil ? () => router.navigate(perfil) : undefined}
+          disabled={!perfil}
+          accessibilityRole="button"
+          accessibilityLabel="Mi perfil"
+          style={[styles.circulo, styles.avatar, { borderRadius: radii.pill }]}>
+          <ThemedText style={styles.avatarTexto}>{iniciales(user.name)}</ThemedText>
+        </PressableScale>
+      ) : null}
+    </View>
+  );
+
+  if (flotante) {
+    return (
+      <View pointerEvents="box-none" style={[styles.flotante, { paddingTop: insets.top + spacing.md, paddingHorizontal: 14 }]}>
+        {fila}
+        <BarraCarga visible={!!cargando} />
+      </View>
+    );
+  }
+
+  return (
+    <Appear distance={10}>
+      <View style={{ paddingTop: spacing.md, paddingHorizontal: 14 }}>
+        {fila}
+        {titulo ? (
+          <View style={[styles.cabecera, { gap: spacing.md }]}>
+            <View style={[styles.flex1, { gap: 6 }]}>
+              <ThemedText style={styles.titulo} numberOfLines={2}>
+                {titulo}
+              </ThemedText>
+              {bajada ? (
+                <ThemedText style={[styles.bajada, { color: colors.textSecondary }]} numberOfLines={2}>
+                  {bajada}
+                </ThemedText>
+              ) : null}
+            </View>
+            {accion ? <View style={styles.accion}>{accion}</View> : null}
+          </View>
+        ) : accion ? (
+          <View style={[styles.soloAccion, { paddingTop: spacing.md }]}>{accion}</View>
+        ) : null}
+        <BarraCarga visible={!!cargando} />
+      </View>
+    </Appear>
+  );
+}
+
+const styles = StyleSheet.create({
+  fila: { flexDirection: 'row', alignItems: 'center' },
+  capsula: {
+    flex: 1,
+    minWidth: 0,
+    minHeight: 52,
+    flexDirection: 'row',
+    alignItems: 'center',
+    gap: 10,
+    paddingVertical: 8,
+    paddingLeft: 8,
+    paddingRight: 14,
+    borderRadius: 20,
+  },
+  marca: { width: 36, height: 36, borderRadius: 12, alignItems: 'center', justifyContent: 'center', flexShrink: 0 },
+  marcaTexto: { fontSize: 14, lineHeight: 18, fontWeight: '700' },
+  eyebrow: { fontSize: 10, lineHeight: 13, letterSpacing: 1.4, fontWeight: '600' },
+  nombre: { fontSize: 14, lineHeight: 18, fontWeight: '600' },
+  circulo: { width: 44, height: 44, alignItems: 'center', justifyContent: 'center', flexShrink: 0 },
+  insignia: {
+    position: 'absolute',
+    top: -3,
+    right: -3,
+    minWidth: 18,
+    height: 18,
+    paddingHorizontal: 5,
+    borderRadius: 9,
+    alignItems: 'center',
+    justifyContent: 'center',
+  },
+  insigniaTexto: { fontSize: 11, lineHeight: 14, fontWeight: '700' },
+  avatar: { backgroundColor: AVATAR_FONDO, borderWidth: 1, borderColor: AVATAR_ARO },
+  avatarTexto: { fontSize: 14, lineHeight: 18, fontWeight: '600', color: AVATAR_TEXTO },
+  cabecera: { flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', paddingTop: 22, paddingBottom: 10, paddingHorizontal: 4 },
+  titulo: { fontSize: 28, lineHeight: 32, fontWeight: '700', letterSpacing: -0.6 },
+  bajada: { fontSize: 13, lineHeight: 18 },
+  accion: { flexShrink: 0 },
+  soloAccion: { flexDirection: 'row', justifyContent: 'flex-end' },
+  flex1: { flex: 1, minWidth: 0 },
+  flotante: { position: 'absolute', top: 0, left: 0, right: 0, zIndex: 10 },
+});
