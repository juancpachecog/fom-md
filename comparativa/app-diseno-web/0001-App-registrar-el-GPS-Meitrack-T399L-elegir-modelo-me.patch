+import * as Clipboard from 'expo-clipboard';
+import { type RefObject, useEffect, useMemo, useState } from 'react';
+import { StyleSheet, View } from 'react-native';
+
+import { Button } from '@/components/button';
+import { Card } from '@/components/card';
+import { Checkbox } from '@/components/checkbox';
+import { AvisoServidor, BotonRedondoGps, IconoGps } from '@/components/gps-piezas';
+import { Pastilla } from '@/components/pastilla';
+import { TextField } from '@/components/text-field';
+import { ThemedText } from '@/components/themed-text';
+import { abrirSms, haceSenal, horaSegundos, RECEPTOR_HOST } from '@/lib/gps-alta';
+import {
+  consultaSms,
+  esApnMeitrack,
+  esClaveMeitrack,
+  FIRMWARE_MEITRACK,
+  leerAnunciados,
+  leerDb4,
+  lecturaConfigurada,
+  PUERTO_MEITRACK,
+  smsConexion,
+  smsRestauracion,
+  tapar,
+  ventanaUsable,
+  type LecturaDb4,
+  type PreparacionMeitrack,
+  type SenalMeitrack,
+} from '@/lib/gps-meitrack';
+import {
+  AVISO_SIN_RUTA,
+  consultarSenalMeitrack,
+  consultarVentanaMeitrack,
+  registrarMeitrack,
+  type AltaMeitrack,
+} from '@/services/fomMeitrack';
+import { useTheme } from '@/theme';
+
+/** Cada cuánto se pregunta por la ventana de recepción: debe ser menos que su vigencia (10 s). */
+const CADA_MS = 5_000;
+
+/** Lo que el paso de registrar necesita saber del paso anterior. */
+export interface EstadoMeitrack {
+  /** Llegó la señal y la lectura posterior confirma el destino. */
+  listo: boolean;
+  /** El servidor todavía no publica las rutas para la app. */
+  sinRuta: boolean;
+}
+
+/** Una casilla con su frase. */
+function Casilla({ marcada, onPress, texto, deshabilitada }: { marcada: boolean; onPress: () => void; texto: string; deshabilitada?: boolean }) {
+  return (
+    <View style={[styles.filaCasilla, deshabilitada && styles.apagado]}>
+      <Checkbox checked={marcada} onPress={deshabilitada ? () => undefined : onPress} label={texto} />
+      <ThemedText variant="caption" color="textSecondary" style={styles.flex}>
+        {texto}
+      </ThemedText>
+    </View>
+  );
+}
+
+/** Un mensaje SMS listo: lo que dice, con la clave tapada, y los botones de copiar y abrir Mensajes. */
+function Comando({
+  numero,
+  titulo,
+  sms,
+  pendiente,
+  nota,
+  onCopiar,
+  onAbrir,
+}: {
+  numero: number;
+  titulo: string;
+  sms: string | null;
+  pendiente: string;
+  nota: string;
+  onCopiar: () => void;
+  onAbrir: () => void;
+}) {
+  const { colors, radii, borderWidths } = useTheme();
+  return (
+    <View style={[styles.comando, { borderTopWidth: borderWidths.hairline, borderTopColor: colors.border }]}>
+      <View style={[styles.numero, { borderRadius: radii.sm, backgroundColor: colors.surfaceSunken }]}>
+        <ThemedText variant="mono" style={styles.negrita}>
+          {String(numero).padStart(2, '0')}
+        </ThemedText>
+      </View>
+      <View style={[styles.flex, { gap: 6 }]}>
+        <ThemedText style={styles.negrita}>{titulo}</ThemedText>
+        <View
+          style={[
+            styles.codigo,
+            { borderRadius: radii.sm, borderColor: colors.border, borderWidth: borderWidths.thin, backgroundColor: colors.surfaceSunken },
+          ]}>
+          <ThemedText variant="mono" color={sms ? 'text' : 'textMuted'}>
+            {sms ? tapar(sms) : pendiente}
+          </ThemedText>
+        </View>
+        <ThemedText variant="caption" color="textSecondary">
+          {nota}
+        </ThemedText>
+      </View>
+      <View style={styles.botones}>
+        <BotonRedondoGps icono="copiar" etiqueta={`Copiar «${titulo}»`} onPress={onCopiar} disabled={!sms} />
+        <BotonRedondoGps icono="mensaje" etiqueta={`Abrir Mensajes con «${titulo}»`} onPress={onAbrir} disabled={!sms} />
+      </View>
+    </View>
+  );
+}
+
+/**
+ * Paso «Configurar y probar» del Meitrack T399L.
+ *
+ * Sigue el camino de la consola de Juan: preguntar al equipo qué entiende,
+ * guardar cómo estaba (DB4), tener lista la restauración y SOLO ENTONCES
+ * apuntarlo al receptor de FOM (IP de la configuración, puerto 5002). Después
+ * se espera su señal. Copiar un mensaje no lo envía y nada de esto activa el GPS.
+ *
+ * Las lecturas del equipo viven solo en esta pantalla: no se guardan ni viajan.
+ */
+export function MeitrackConfigurar({
+  imei,
+  linea,
+  apn,
+  clave,
+  ahora,
+  enFoco,
+  onEstado,
+}: {
+  imei: string;
+  linea: string;
+  apn: string;
+  clave: string;
+  ahora: number;
+  enFoco: RefObject<boolean>;
+  onEstado: (e: EstadoMeitrack) => void;
+}) {
+  const { spacing, colors, radii } = useTheme();
+  const [anunciadosTxt, setAnunciadosTxt] = useState('');
+  const [baseTxt, setBaseTxt] = useState('');
+  const [base, setBase] = useState<LecturaDb4 | null>(null);
+  const [despuesTxt, setDespuesTxt] = useState('');
+  const [sinUsuario, setSinUsuario] = useState(false);
+  const [guardada, setGuardada] = useState<string | null>(null);
+  const [aviso, setAviso] = useState<string | null>(null);
+
+  // 'desconocida' mientras no ha contestado; 'sin-ruta' si el servidor aún no la publica.
+  const [ruta, setRuta] = useState<'desconocida' | 'ok' | 'sin-ruta'>('desconocida');
+  const [ventana, setVentana] = useState<{ datos: PreparacionMeitrack; en: number } | null>(null);
+  const [senal, setSenal] = useState<SenalMeitrack | null>(null);
+  const [fallo, setFallo] = useState<string | null>(null);
+
+  const destino = useMemo(() => ({ host: RECEPTOR_HOST, port: PUERTO_MEITRACK }), []);
+  const anunciados = leerAnunciados(anunciadosTxt);
+  const lista = anunciados ?? [];
+
+  // La ventana y la señal: se vuelve a preguntar mientras la pantalla está a la vista.
+  useEffect(() => {
+    if (!/^\d{15}$/u.test(imei)) return;
+    let vivo = true;
+    let reloj: ReturnType<typeof setTimeout> | undefined;
+    const vuelta = async () => {
+      let seguir = true;
+      if (enFoco.current) {
+        const v = await consultarVentanaMeitrack(imei);
+        if (!vivo) return;
+        if (v.tipo === 'sin-ruta') {
+          setRuta('sin-ruta');
+          seguir = false;
+        } else if (v.tipo === 'error') {
+          setFallo(v.mensaje);
+          setVentana(null);
+        } else {
+          setRuta('ok');
+          setFallo(null);
+          setVentana({ datos: v.datos, en: Date.now() });
+          if (v.datos.window) {
+            const s = await consultarSenalMeitrack(imei, v.datos.window.reference);
+            if (!vivo) return;
+            if (s.tipo === 'ok' && s.datos.recibida) setSenal(s.datos);
+          }
+        }
+      }
+      if (vivo && seguir) reloj = setTimeout(() => void vuelta(), CADA_MS);
+    };
+    void vuelta();
+    return () => {
+      vivo = false;
+      if (reloj) clearTimeout(reloj);
+    };
+  }, [imei, enFoco]);
+
+  const claveOk = esClaveMeitrack(clave);
+  const llave = JSON.stringify([base, clave, apn, sinUsuario]);
+  const restauracionGuardada = guardada === llave;
+  const lecturaInicial = baseTxt ? leerDb4(baseTxt, imei, 'CLOSE') : null;
+  const restauracion = smsRestauracion(clave, base, sinUsuario);
+
+  /** Sin ruta no se puede saber si hay ventana: se deja preparar el mensaje, con el aviso a la vista. */
+  const ventanaLista = ruta === 'sin-ruta' || ventanaUsable(ventana?.datos ?? null, ventana ? Math.max(0, ahora - ventana.en) : Infinity);
+  const conexion =
+    senal?.recibida || !ventanaLista
+      ? null
+      : smsConexion({ clave, base, apn, sinUsuario, restauracionGuardada, anunciados: lista, destino });
+
+  const configurado = lecturaConfigurada(despuesTxt, base, imei, apn, destino);
+  const listo = senal?.recibida === true && configurado && sinUsuario;
+  useEffect(() => {
+    onEstado({ listo, sinRuta: ruta === 'sin-ruta' });
+  }, [listo, ruta, onEstado]);
+
+  async function copiar(texto: string | null) {
+    if (!texto) {
+      setAviso('Todavía falta algo antes de copiar este mensaje.');
+      return;
+    }
+    try {
+      await Clipboard.setStringAsync(texto);
+      setAviso('Mensaje copiado. Mándalo desde Mensajes a la línea del equipo; FOM no lo envía.');
+    } catch {
+      setAviso('No se pudo copiar. El mensaje no se ha enviado.');
+    }
+  }
+
+  async function abrir(texto: string | null) {
+    if (!texto) return;
+    if (!linea.trim()) {
