+
+/**
+ * Paso «Registrar» del Meitrack T399L: lo deja en el inventario. No lo instala
+ * en una unidad ni lo activa; eso se hace después con la señal ya comprobada.
+ */
+export function MeitrackRegistrar({
+  alta,
+  estado,
+  onRegistrado,
+}: {
+  alta: AltaMeitrack;
+  estado: EstadoMeitrack;
+  onRegistrado: (id: string) => void;
+}) {
+  const { spacing } = useTheme();
+  const [ocupado, setOcupado] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [sinRutaAlRegistrar, setSinRutaAlRegistrar] = useState(false);
+  // Un intento ya hecho nunca vuelve a escribir: solo se vuelve a comprobar.
+  const [intento, setIntento] = useState<{ intentado: boolean; id: string | null }>({ intentado: false, id: null });
+
+  const sinRuta = estado.sinRuta || sinRutaAlRegistrar;
+
+  async function registrar() {
+    setError(null);
+    setOcupado(true);
+    try {
+      const r = await registrarMeitrack(alta, {
+        ...intento,
+        anotar: (id) => setIntento({ intentado: true, id }),
+      });
+      if (r.tipo === 'sin-ruta') setSinRutaAlRegistrar(true);
+      else if (r.tipo === 'error') setError(r.mensaje);
+      else if ('id' in r.datos) onRegistrado(r.datos.id);
+      else {
+        setError(
+          r.datos.conflicto
+            ? 'Ya hay un registro con otros datos para ese IMEI o esa SIM. Revisa el inventario.'
+            : 'No pudimos confirmar el registro. No lo repitas: espera un momento y toca Registrar otra vez para volver a comprobar.',
+        );
+      }
+    } catch (e) {
+      setError(e instanceof Error ? e.message : 'No se pudo registrar el equipo.');
+    }
+    // Después del try/catch y no en un `finally`: el compilador de React se salta los componentes con `finally`.
+    setOcupado(false);
+  }
+
+  return (
+    <Card style={{ gap: spacing.md }}>
+      <ThemedText style={styles.cardTitulo}>Meitrack T399L</ThemedText>
+      <ThemedText variant="mono" color="textSecondary">{`IMEI ${alta.imei}`}</ThemedText>
+      <ThemedText variant="caption" color="textSecondary">
+        {`Línea ${alta.linea} · ${alta.operadora} · APN ${alta.apn}`}
+      </ThemedText>
+      <ThemedText variant="caption" color="textSecondary">
+        Se guarda en el inventario de FOM. No se instala en una unidad ni se activa: eso es un paso aparte, con la señal ya comprobada.
+      </ThemedText>
+      {sinRuta ? <AvisoServidor titulo="Todavía no está en el servidor publicado" texto={AVISO_SIN_RUTA} /> : null}
+      {!estado.listo && !sinRuta ? (
+        <ThemedText variant="caption" color="warning">
+          Antes de registrar tiene que llegar la señal del equipo y la lectura DB4 de después tiene que confirmar el destino (paso anterior).
+        </ThemedText>
+      ) : null}
+      {error ? (
+        <ThemedText variant="caption" color="danger">
+          {error}
+        </ThemedText>
+      ) : null}
+      <Button
+        label={ocupado ? 'Registrando…' : 'Registrar en el inventario'}
+        onPress={() => void registrar()}
+        loading={ocupado}
+        disabled={!estado.listo || sinRuta}
+      />
+    </Card>
+  );
+}
