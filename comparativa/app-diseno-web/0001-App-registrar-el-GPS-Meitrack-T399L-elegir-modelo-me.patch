+/**
+ * Meitrack T399L — lo que se le pregunta y se le pide al servidor.
+ *
+ * Las cuatro rutas de fom-core son las de la consola de Juan
+ * (`/api/v1/console/meitrack-setup/{readiness,capture,registration,register}`),
+ * que se entra con cookie de consola y no sirve a la app, que usa Bearer. Aquí
+ * se piden por su gemela móvil, `/api/v1/mobile/meitrack-setup/…`, que
+ * TODAVÍA NO está en el servidor publicado: mientras responda 404, cada llamada
+ * devuelve `sin-ruta` y la pantalla enseña el aviso en vez de fallar. El día
+ * que Juan la publique con ese nombre, esto empieza a funcionar sin tocar nada.
+ */
+
+import { ErrorFom, mensajeDe, pedir } from '@/lib/fom-api';
+import {
+  FABRICANTE_MEITRACK,
+  FIRMWARE_MEITRACK,
+  leerPreparacion,
+  leerSenal,
+  leerTestigo,
+  MODELO_MEITRACK,
+  PROTOCOLO_MEITRACK,
+  registrarUnaVez,
+  type PreparacionMeitrack,
+  type SenalMeitrack,
+  type TestigoAlta,
+} from '@/lib/gps-meitrack';
+import { RECEPTOR_HOST } from '@/lib/gps-alta';
+
+import { rutaDeEnte } from './fomRutas';
+
+const RUTA = '/meitrack-setup';
+
+/** Qué pasó con una llamada: respondió, no existe todavía, o falló. */
+export type Respuesta<T> = { tipo: 'ok'; datos: T } | { tipo: 'sin-ruta' } | { tipo: 'error'; mensaje: string };
+
+export const AVISO_SIN_RUTA =
+  'Registrar este modelo desde la app todavía no está en el servidor publicado de FOM. Los pasos de los mensajes ya sirven; el registro se habilita cuando el servidor lo publique.';
+
+/** Una ruta que el servidor aún no tiene: 404/405, o el 403/404 en HTML de nginx. */
+function esSinRuta(e: unknown): boolean {
+  return (
+    e instanceof ErrorFom &&
+    (e.statusCode === 404 || e.statusCode === 405 || (e.code === 'respuesta_no_json' && e.statusCode === 403))
+  );
+}
+
+/** Lo que dijo el servidor, en llano. El texto original no se enseña. */
+export function mensajeMeitrack(e: unknown): string {
+  if (e instanceof ErrorFom) {
+    if (e.statusCode === 401 || e.statusCode === 403) return 'Tu cuenta no puede registrar equipos GPS.';
+    if (e.statusCode === 409) {
+      if (/capture/i.test(e.message)) return 'FOM todavía no ha recibido la señal de este equipo. Envía los mensajes y espera a que llegue.';
+      return 'Ese IMEI o esa SIM ya están registrados, o hay un registro por confirmar. Revisa el inventario.';
+    }
+    if (e.statusCode === 400) return 'FOM no aceptó los datos del equipo. Revisa el IMEI, la línea y el APN.';
+  }
+  return mensajeDe(e);
+}
+
+/** Lecturas: no cambian nada, así que no deben borrar lo que la app ya leyó. */
+async function consultar(sufijo: string, cuerpo: unknown): Promise<Respuesta<unknown>> {
+  try {
+    const datos = await pedir(rutaDeEnte(`${RUTA}/${sufijo}`), { metodo: 'POST', cuerpo, invalidar: false });
+    return { tipo: 'ok', datos };
+  } catch (e) {
+    return esSinRuta(e) ? { tipo: 'sin-ruta' } : { tipo: 'error', mensaje: mensajeMeitrack(e) };
+  }
+}
+
+/** ¿Hay una ventana abierta para recibir a este equipo? No la abre. */
+export async function consultarVentanaMeitrack(imei: string): Promise<Respuesta<PreparacionMeitrack>> {
+  const r = await consultar('readiness', { imei, firmware: FIRMWARE_MEITRACK });
+  if (r.tipo !== 'ok') return r;
+  const datos = leerPreparacion(r.datos, RECEPTOR_HOST);
+  return datos ? { tipo: 'ok', datos } : { tipo: 'error', mensaje: 'FOM contestó algo que la app no entiende. Intenta más tarde.' };
+}
+
+/** ¿Llegó una trama de este equipo durante la ventana? No activa nada. */
+export async function consultarSenalMeitrack(imei: string, referencia: string): Promise<Respuesta<SenalMeitrack>> {
+  const r = await consultar('capture', { imei, firmware: FIRMWARE_MEITRACK });
+  if (r.tipo !== 'ok') return r;
+  const datos = leerSenal(r.datos, referencia);
+  return datos ? { tipo: 'ok', datos } : { tipo: 'error', mensaje: 'FOM contestó algo que la app no entiende. Intenta más tarde.' };
+}
+
+/** Lo que se escribe del equipo: solo inventario, sin unidad. */
+export interface AltaMeitrack {
+  imei: string;
+  linea: string;
+  iccid: string;
+  operadora: string;
+  apn: string;
+  serie?: string;
+  estadoSim?: 'active' | 'inactive' | 'suspended' | 'unknown';
+  planSim?: string;
+}
+
+function cuerpoDeAlta(a: AltaMeitrack): Record<string, string> {
+  const opcional = (clave: string, valor?: string) => (valor?.trim() ? { [clave]: valor.trim() } : {});
+  return {
+    imei: a.imei.trim(),
+    simPhone: a.linea.trim(),
+    iccid: a.iccid.trim(),
+    carrier: a.operadora.trim(),
+    apn: a.apn.trim(),
+    manufacturer: FABRICANTE_MEITRACK,
+    model: MODELO_MEITRACK,
+    protocolFamily: PROTOCOLO_MEITRACK,
+    transport: 'tcp',
+    firmwareVersion: FIRMWARE_MEITRACK,
+    ...opcional('serialNumber', a.serie),
+    ...opcional('simStatus', a.estadoSim),
+    ...opcional('simPlan', a.planSim),
+  };
+}
+
+/**
+ * Registra el T399L en el inventario, UNA vez. Primero pregunta si ya existe;
+ * si el envío queda dudoso, solo vuelve a leer. Devuelve el id del equipo.
+ */
+export async function registrarMeitrack(
+  alta: AltaMeitrack,
+  estado: { intentado: boolean; id: string | null; anotar: (id: string | null) => void },
+): Promise<Respuesta<{ id: string } | { pendiente: true; conflicto: boolean }>> {
+  const cuerpo = cuerpoDeAlta(alta);
+  // En un objeto: las funciones de abajo lo cambian y TS no sigue esos cambios en una variable suelta.
+  const visto: { sinRuta: boolean; fallo: string | null } = { sinRuta: false, fallo: null };
+  const consultarTestigo = async (): Promise<TestigoAlta> => {
+    const r = await consultar('registration', cuerpo);
+    if (r.tipo === 'sin-ruta') {
+      visto.sinRuta = true;
+      return { estado: 'unavailable', id: null };
+    }
+    if (r.tipo === 'error') {
+      visto.fallo = r.mensaje;
+      return { estado: 'unavailable', id: null };
+    }
+    return leerTestigo(r.datos) ?? { estado: 'unavailable', id: null };
+  };
+  const crear = async (): Promise<string | null> => {
+    try {
+      const creado = (await pedir(rutaDeEnte(`${RUTA}/register`), { metodo: 'POST', cuerpo })) as { id?: unknown };
+      return typeof creado?.id === 'string' ? creado.id : null;
+    } catch (e) {
+      // Un 4xx claro dice por qué; solo lo dudoso se resuelve leyendo.
+      if (e instanceof ErrorFom && e.statusCode >= 400 && e.statusCode < 500) visto.fallo = mensajeMeitrack(e);
+      throw e;
+    }
+  };
+  const r = await registrarUnaVez({
+    intentado: estado.intentado,
+    idConocido: estado.id,
+    consultar: consultarTestigo,
+    crear,
+    anotarIntento: estado.anotar,
+  });
+  if (visto.sinRuta) return { tipo: 'sin-ruta' };
+  if (r.estado === 'confirmado') return { tipo: 'ok', datos: { id: r.id } };
+  if (visto.fallo) return { tipo: 'error', mensaje: visto.fallo };
+  return { tipo: 'ok', datos: { pendiente: true, conflicto: r.estado === 'conflicto' } };
+}
