@@ -0,0 +1,59 @@
+import type { MigrationBuilder } from 'node-pg-migrate/dist/bundle/index';
+
+/**
+ * Índice para la última posición válida de cada unidad.
+ *
+ * La lista móvil de vehículos (un LATERAL por unidad), la ficha y las rutas
+ * position/latest de móvil y consola piden lo mismo:
+ *
+ *   WHERE tenant_id = $1 AND vehicle_id = $2 AND position_valid = true
+ *   ORDER BY event_time DESC NULLS LAST, received_at DESC, id DESC
+ *   LIMIT 1
+ *
+ * El índice existente gps_positions_vehicle_received_idx no sirve para ese
+ * orden porque empieza por received_at: PostgreSQL recorre todas las
+ * posiciones de la unidad y las ordena para quedarse con una. Con este índice,
+ * cuyo orden es exactamente el de la consulta, la respuesta es leer una
+ * entrada. Es parcial (solo posiciones válidas con unidad), así que no paga
+ * nada por las tramas inválidas ni por los equipos sin vincular.
+ *
+ * Las consultas no cambian: el índice solo acelera lo que ya se pide. El
+ * recorrido (received_at DESC, id DESC) sigue usando el índice existente.
+ *
+ * BLOQUEO. El repositorio aplica migraciones con --single-transaction, que no
+ * admite CREATE INDEX CONCURRENTLY. Un CREATE INDEX normal toma SHARE sobre
+ * fom.gps_positions: las lecturas siguen, pero los INSERT del ingestor esperan
+ * mientras se construye. El lock_timeout de tres segundos hace que aborte
+ * limpia si no consigue el bloqueo; el statement_timeout acota cuánto puede
+ * frenar la ingesta: si la tabla ya es tan grande que la construcción no cabe
+ * en ese tiempo, la migración falla sin efecto y el índice debe crearse en
+ * una ventana operativa propia (CONCURRENTLY fuera de este flujo).
+ *
+ * Sin datos que mover: up y down son solo esquema y down no pierde nada.
+ */
+export const up = (pgm: MigrationBuilder): void => {
+  pgm.sql(`SET LOCAL lock_timeout = '3s';`);
+  pgm.sql(`SET LOCAL statement_timeout = '120s';`);
+  pgm.sql(`
+    CREATE INDEX gps_positions_vehicle_latest_valid_idx
+      ON fom.gps_positions (
+        tenant_id,
+        vehicle_id,
+        event_time DESC NULLS LAST,
+        received_at DESC,
+        id DESC
+      )
+      WHERE position_valid AND vehicle_id IS NOT NULL;
+
+    COMMENT ON INDEX fom.gps_positions_vehicle_latest_valid_idx IS
+      'Latest valid position per vehicle; same order as the latest-position queries';
+  `);
+  // Con --single-transaction el ajuste seguiría vivo para las migraciones que
+  // vengan detrás en la misma corrida; el tope es solo para este índice.
+  pgm.sql(`RESET statement_timeout;`);
+};
+
+export const down = (pgm: MigrationBuilder): void => {
+  pgm.sql(`SET LOCAL lock_timeout = '3s';`);
+  pgm.sql(`DROP INDEX fom.gps_positions_vehicle_latest_valid_idx;`);
+};
