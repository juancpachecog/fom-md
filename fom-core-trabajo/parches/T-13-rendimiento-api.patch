diff --git a/test/api-performance-t13.test.js b/test/api-performance-t13.test.js
new file mode 100644
index 0000000..1960cd0
--- /dev/null
+++ b/test/api-performance-t13.test.js
@@ -0,0 +1,376 @@
+'use strict';
+
+// T-13: menos pedidos y más baratos. Cada prueba fija una de las piezas:
+// ETag/304 en catálogos, contador de avisos, estados múltiples de SOS,
+// última posición en la lista de consola, métricas en lote, planes por
+// unidad, tope de página e índice de última posición.
+
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const { request } = require('node:http');
+const { join } = require('node:path');
+const { test } = require('node:test');
+const { ValidationPipe } = require('@nestjs/common');
+const { Test } = require('@nestjs/testing');
+const { plainToInstance } = require('class-transformer');
+const { validateSync } = require('class-validator');
+
+const { ConsoleController } = require('../dist/console-api/console.controller.js');
+const {
+  ConsoleOperationsController,
+} = require('../dist/console-api/console-operations.controller.js');
+const { ConsoleFleetService } = require('../dist/console-api/console-fleet.service.js');
+const {
+  ConsoleOperationsService,
+} = require('../dist/console-api/console-operations.service.js');
+const {
+  TelemetryCapabilitiesService,
+} = require('../dist/console-api/telemetry-capabilities.service.js');
+const { ConsoleSessionGuard } = require('../dist/console-api/console-session.guard.js');
+const {
+  ConsoleBrowserMutationGuard,
+} = require('../dist/console-api/console-browser-mutation.guard.js');
+const { TenantScopeService } = require('../dist/console-api/tenant-scope.service.js');
+const {
+  GpsPositionQueryService,
+} = require('../dist/gps-console/gps-position-query.service.js');
+const {
+  MaintenancePlanQueryDto,
+  FleetDailyMetricsQueryDto,
+} = require('../dist/console-api/console.dto.js');
+const { EmergencyListQueryDto } = require('../dist/emergencies/emergency.dto.js');
+const {
+  runWithActorStore,
+  setCurrentActor,
+} = require('../dist/authentication/actor-context.js');
+
+const root = join(__dirname, '..');
+const read = (file) => readFileSync(join(root, file), 'utf8');
+
+const TENANT = '10000000-0000-4000-8000-000000000001';
+const VEHICLE_A = '40000000-0000-4000-8000-000000000001';
+const VEHICLE_B = '40000000-0000-4000-8000-000000000002';
+const allow = { canActivate: () => true };
+
+function validationPipe() {
+  return new ValidationPipe({
+    transform: true,
+    whitelist: true,
+    forbidNonWhitelisted: true,
+  });
+}
+
+function fakeDatabase(rows) {
+  const calls = [];
+  return {
+    calls,
+    async query(sql, params) {
+      calls.push({ sql, params });
+      return { rows: typeof rows === 'function' ? rows(sql, params) : rows };
+    },
+  };
+}
+
+const visibleScope = {
+  async requireVisible(tenantId) {
+    return { tenantId };
+  },
+};
+
+test('main fija ETag débil y los catálogos se revalidan con 304', async (t) => {
+  const main = read('src/main.ts');
+  assert.match(main, /app\.set\('etag', 'weak'\)/u);
+
+  let listed = 0;
+  const fleet = {
+    listAreas: async () => {
+      listed += 1;
+      return { items: [{ id: 'a', name: 'Norte' }], page: { limit: 50, offset: 0, count: 1, total: 1 } };
+    },
+  };
+  const module = await Test.createTestingModule({
+    controllers: [ConsoleController],
+    providers: [
+      { provide: ConsoleFleetService, useValue: fleet },
+      { provide: TelemetryCapabilitiesService, useValue: {} },
+      { provide: GpsPositionQueryService, useValue: {} },
+      { provide: TenantScopeService, useValue: {} },
+      { provide: ConsoleSessionGuard, useValue: allow },
+    ],
+  })
+    .overrideGuard(ConsoleSessionGuard)
+    .useValue(allow)
+    .compile();
+  const app = module.createNestApplication();
+  app.set('etag', 'weak');
+  app.useGlobalPipes(validationPipe());
+  await app.listen(0, '127.0.0.1');
+  t.after(async () => app.close());
+  const port = app.getHttpServer().address().port;
+  const url = `http://127.0.0.1:${port}/api/v1/console/areas`;
+
+  const first = await fetch(url);
+  assert.equal(first.status, 200);
+  assert.equal(first.headers.get('cache-control'), 'private, no-cache');
+  const etag = first.headers.get('etag');
+  assert.match(etag, /^W\/"/u);
+
+  // node:http y no fetch: el fetch de Node (como el del navegador cuando se
+  // pone If-None-Match a mano) añade Cache-Control: no-cache, y Express trata
+  // esa petición como no revalidable. El navegador revalida solo, sin ese
+  // encabezado, gracias a 'private, no-cache'.
+  const second = await new Promise((resolve, reject) => {
+    request(url, { headers: { 'If-None-Match': etag } }, (response) => {
+      let body = '';
+      response.on('data', (chunk) => { body += chunk; });
+      response.on('end', () => resolve({ status: response.statusCode, body }));
+    }).on('error', reject).end();
+  });
+  assert.equal(second.status, 304);
+  assert.equal(second.body, '');
+  assert.equal(listed, 2, 'el 304 ahorra el cuerpo, no la consulta');
+});
+
+test('catálogos móviles y de consola dejan no-store por revalidación privada', () => {
+  const files = {
+    'src/console-api/console.controller.ts': 2,
+    'src/console-api/console-operations.controller.ts': 1,
+    'src/console-api/console-maintenance.controller.ts': 1,
+    'src/console-api/console-tenant-daily-reads.controller.ts': 2,
+    'src/mobile/mobile-operations.controller.ts': 3,
+    'src/mobile/mobile-tenant-scope.controller.ts': 3,
+  };
+  for (const [file, expected] of Object.entries(files)) {
+    const source = read(file);
+    assert.equal(
+      (source.match(/@Header\('Cache-Control', 'private, no-cache'\)/gu) ?? []).length,
+      expected,
+      file,
+    );
+  }
+  // El directorio lleva datos personales: sigue sin guardarse en disco.
+  assert.doesNotMatch(
+    read('src/mobile/mobile-administration.controller.ts'),
+    /private, no-cache/u,
+  );
+});
+
+test('consola cuenta avisos sin leer sin listarlos y excluye descartados', async (t) => {
+  const calls = [];
+  const operations = {
+    countUnreadNotifications: async (tenantId) => {
+      calls.push(tenantId);
+      return { unread: 3 };
+    },
+  };
+  const module = await Test.createTestingModule({
+    controllers: [ConsoleOperationsController],
+    providers: [{ provide: ConsoleOperationsService, useValue: operations }],
+  })
+    .overrideGuard(ConsoleSessionGuard)
+    .useValue(allow)
+    .overrideGuard(ConsoleBrowserMutationGuard)
+    .useValue(allow)
+    .compile();
+  const app = module.createNestApplication();
+  app.useGlobalPipes(validationPipe());
+  await app.listen(0, '127.0.0.1');
+  t.after(async () => app.close());
+  const base = `http://127.0.0.1:${app.getHttpServer().address().port}/api/v1/console`;
+
+  const own = await fetch(`${base}/notifications/unread-count`);
+  assert.equal(own.status, 200);
+  assert.deepEqual(await own.json(), { unread: 3 });
+  assert.equal(own.headers.get('cache-control'), 'no-store');
+  const scoped = await fetch(`${base}/tenants/${TENANT}/notifications/unread-count`);
+  assert.equal(scoped.status, 200);
+  assert.equal(
+    (await fetch(`${base}/tenants/not-a-uuid/notifications/unread-count`)).status,
+    400,
+  );
+  assert.deepEqual(calls, [undefined, TENANT]);
+
+  const database = fakeDatabase([{ unread: '7' }]);
+  const service = Object.create(ConsoleOperationsService.prototype);
+  service.database = database;
+  service.tenantScope = visibleScope;
+  const result = await runWithActorStore(async () => {
+    setCurrentActor({ tenantId: TENANT, userId: 'u1', role: 'supervisor' });
+    return service.countUnreadNotifications(TENANT);
+  });
+  assert.deepEqual(result, { unread: 7 });
+  const { sql, params } = database.calls[0];
+  assert.match(sql, /count\(\*\)/u);
+  assert.match(sql, /receipt\.read_at IS NULL/u);
+  assert.match(sql, /receipt\.dismissed_at IS NULL/u);
+  assert.doesNotMatch(sql, /LIMIT/u);
+  assert.deepEqual(params, [TENANT, 'u1']);
+});
+
+test('emergencias aceptan varios estados en un pedido y tope 200', () => {
+  const parse = (query) => {
+    const dto = plainToInstance(EmergencyListQueryDto, query);
+    return { dto, errors: validateSync(dto, { whitelist: true, forbidNonWhitelisted: true }) };
+  };
+  const both = parse({ status: 'active,acknowledged' });
+  assert.equal(both.errors.length, 0);
+  assert.deepEqual(both.dto.status, ['active', 'acknowledged']);
+  const repeated = parse({ status: ['active', 'resolved'] });
+  assert.equal(repeated.errors.length, 0);
+  assert.deepEqual(repeated.dto.status, ['active', 'resolved']);
+  const single = parse({ status: 'active' });
+  assert.deepEqual(single.dto.status, ['active']);
+  assert.ok(parse({ status: 'active,bogus' }).errors.length > 0);
+  assert.ok(parse({ status: 'active,active' }).errors.length > 0);
+  assert.equal(parse({ limit: '200' }).errors.length, 0);
+  assert.ok(parse({ limit: '201' }).errors.length > 0);
+
+  const service = read('src/emergencies/emergency.service.ts');
+  assert.match(service, /status = ANY\(\$3::varchar\[\]\)/u);
+  assert.match(service, /status = ANY\(\$2::varchar\[\]\)/u);
+  assert.doesNotMatch(service, /query\.status \?\? null/u);
+});
+
+test('la lista de consola trae la última posición del estado vivo', async () => {
+  const database = fakeDatabase([
+    {
+      id: VEHICLE_A,
+      code: 'U-1',
+      hasPosition: true,
+      motionState: 'parada',
+      latestPositionAt: '2026-10-16T10:00:00.000Z',
+      latestLatitude: 19.43,
