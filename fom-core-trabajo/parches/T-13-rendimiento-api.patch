+  assert.equal(result.vehicles.length, 2);
+  assert.equal(result.vehicles[0].vehicleId, VEHICLE_A);
+  assert.equal(result.vehicles[0].items.length, 2);
+  assert.equal(result.vehicles[0].items[0].distanceMeters, 1000.5);
+  assert.equal(result.vehicles[0].items[0].vehicleId, undefined);
+  assert.deepEqual(result.range, {
+    from: '2026-10-01', to: '2026-10-31', vehicleCount: 2, count: 3,
