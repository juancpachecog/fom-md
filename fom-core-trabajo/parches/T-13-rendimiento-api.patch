+  assert.ok(dto({ from: '2026-10-01', to: '2026-10-02', vehicleIds: 'x' }).length > 0);
+  assert.ok(dto({ to: '2026-10-02' }).length > 0);
+
+  const consoleController = read('src/console-api/console.controller.ts');
