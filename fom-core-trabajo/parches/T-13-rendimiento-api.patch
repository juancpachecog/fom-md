+  assert.match(consoleController, /operationId: 'consoleFleetDailyMetrics'/u);
+  assert.match(insights, /@Get\('tenants\/:tenantId\/daily-metrics'\)/u);
+  assert.match(insights, /operationId: 'consoleTenantFleetDailyMetrics'/u);
