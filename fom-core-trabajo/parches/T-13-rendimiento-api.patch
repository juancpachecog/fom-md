+
+test('métricas diarias en lote: una consulta, agrupadas por unidad', async () => {
+  const database = fakeDatabase([
+    { vehicleId: VEHICLE_A, metricDate: '2026-10-02', distanceMeters: '1000.5', maxSpeedKph: '80.00', safetyIndex: null },
+    { vehicleId: VEHICLE_A, metricDate: '2026-10-01', distanceMeters: '10', maxSpeedKph: null, safetyIndex: '95.5' },
